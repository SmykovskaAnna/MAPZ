module lab08_habit_static

-- Спрощена статична модель HabitTracker за діаграмою класів ЛР2.
abstract sig Користувач {}
sig ЗареєстрованийКористувач extends Користувач {
  звичкиКористувача: set Звичка
}
sig Гість extends Користувач {}

abstract sig СтанЗвички {}
one sig Чернетка, ОчікуєВиконання, ПеріодВиконано,
        Призупинена, Архівована extends СтанЗвички {}

sig Період {}
sig Коментар {}

sig Категорія {
  звичкиКатегорії: set Звичка
}

sig Звичка {
  власник: one ЗареєстрованийКористувач,
  категорія: one Категорія,
  стан: one СтанЗвички,
  поточнийПеріод: one Період,
  записи: set ЗаписВиконання
}

sig ЗаписВиконання {
  звичкаЗапису: one Звичка,
  періодЗапису: one Період,
  коментар: lone Коментар
}

-- Зв'язок користувача зі звичками в обидва боки.
fact ВласникЗвички {
  all u: ЗареєстрованийКористувач, h: Звичка |
    h in u.звичкиКористувача iff h.власник = u
}

-- Кожен запис є частиною рівно однієї звички (композиція з ЛР2).
fact КомпозиціяЗапису {
  all h: Звичка, r: ЗаписВиконання |
    r in h.записи iff r.звичкаЗапису = h
  all r: ЗаписВиконання | one записи.r
}

fact КатегоріяЗвички {
  all c: Категорія, h: Звичка |
    h in c.звичкиКатегорії iff h.категорія = c
}

-- Бізнес-правило: один запис для однієї звички за один період.
fact ОдинЗаписНаПеріод {
  all disj r1, r2: ЗаписВиконання |
    r1.звичкаЗапису != r2.звичкаЗапису or
    r1.періодЗапису != r2.періодЗапису
}

pred ПрикладЗвичкиБезЗапису {
  some h: Звичка | no h.записи
}
run ПрикладЗвичкиБезЗапису for 4 expect 1

pred ПрикладІсторіїЗаДваПеріоди {
  some h: Звичка, disj r1, r2: ЗаписВиконання |
    r1.звичкаЗапису = h and r2.звичкаЗапису = h and
    r1.періодЗапису != r2.періодЗапису
}
run ПрикладІсторіїЗаДваПеріоди for 5 expect 1

-- Контрприклад: у ЛР2 композиція дозволяє 0..* записів, отже не кожна
-- звичка вже має запис виконання. Твердження нижче є надто сильним.
assert КожнаЗвичкаМаєЗапис {
  all h: Звичка | some h.записи
}
check КожнаЗвичкаМаєЗапис for 4 expect 1

assert ЗаписНалежитьОднійЗвичці {
  all r: ЗаписВиконання | one записи.r
}
check ЗаписНалежитьОднійЗвичці for 4 expect 0

assert НемаєДубляЗаПеріод {
  all disj r1, r2: ЗаписВиконання |
    r1.звичкаЗапису != r2.звичкаЗапису or
    r1.періодЗапису != r2.періодЗапису
}
check НемаєДубляЗаПеріод for 4 expect 0
