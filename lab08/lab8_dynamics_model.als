module lab08_habit_dynamic

-- Динамічна модель класу «Звичка» за діаграмою станів ЛР5.
abstract sig HabitState {}
one sig Чернетка, Очікує, ПеріодВиконано, Призупинена, Архівована
  extends HabitState {}

sig Період {}
sig Звичка {
  var стан: one HabitState,
  var поточнийПеріод: one Період,
  var станДоПаузи: lone HabitState
}

sig ЗаписВиконання {
  звичка: one Звичка,
  період: one Період
}
var sig ВиконаніЗаписи in ЗаписВиконання {}

fact УнікальнийЗаписЗаПеріод {
  all disj r1, r2: ЗаписВиконання |
    r1.звичка != r2.звичка or r1.період != r2.період
}

pred ПочатковийСтан {
  no ВиконаніЗаписи
  all h: Звичка | h.стан = Чернетка and no h.станДоПаузи
}

-- Інваріант ЛР7: чотири умови про період, записи й паузу.
pred Інваріант {
  all h: Звичка |
    h.стан = ПеріодВиконано implies
      some r: ВиконаніЗаписи | r.звичка = h and r.період = h.поточнийПеріод
  all h: Звичка |
    (h.стан = Призупинена) iff some h.станДоПаузи
  all h: Звичка |
    some h.станДоПаузи implies h.станДоПаузи in Очікує + ПеріодВиконано
  all disj r1, r2: ВиконаніЗаписи |
    r1.звичка != r2.звичка or r1.період != r2.період
}

pred framesExceptStatus[h: Звичка] {
  all x: Звичка - h | x.стан' = x.стан
}
pred framesExceptPeriod[h: Звичка] {
  all x: Звичка - h | x.поточнийПеріод' = x.поточнийПеріод
}
pred framesExceptPause[h: Звичка] {
  all x: Звичка - h | x.станДоПаузи' = x.станДоПаузи
}

-- Переходи з ЛР5.
pred Активувати[h: Звичка] {
  h.стан = Чернетка
  h.стан' = Очікує
  framesExceptStatus[h]
  all x: Звичка | x.поточнийПеріод' = x.поточнийПеріод
  all x: Звичка | x.станДоПаузи' = x.станДоПаузи
  ВиконаніЗаписи' = ВиконаніЗаписи
}

pred ПозначитиВиконаною[h: Звичка, r: ЗаписВиконання] {
  h.стан = Очікує
  r.звичка = h
  r.період = h.поточнийПеріод
  r not in ВиконаніЗаписи
  h.стан' = ПеріодВиконано
  framesExceptStatus[h]
  all x: Звичка | x.поточнийПеріод' = x.поточнийПеріод
  all x: Звичка | x.станДоПаузи' = x.станДоПаузи
  ВиконаніЗаписи' = ВиконаніЗаписи + r
}

pred НовийПеріод[h: Звичка, p: Період] {
  h.стан = ПеріодВиконано
  p != h.поточнийПеріод
  h.стан' = Очікує
  h.поточнийПеріод' = p
  framesExceptStatus[h]
  framesExceptPeriod[h]
  all x: Звичка | x.станДоПаузи' = x.станДоПаузи
  ВиконаніЗаписи' = ВиконаніЗаписи
}

pred Призупинити[h: Звичка] {
  h.стан in Очікує + ПеріодВиконано
  h.стан' = Призупинена
  h.станДоПаузи' = h.стан
  framesExceptStatus[h]
  framesExceptPause[h]
  all x: Звичка | x.поточнийПеріод' = x.поточнийПеріод
  ВиконаніЗаписи' = ВиконаніЗаписи
}

pred Відновити[h: Звичка] {
  h.стан = Призупинена
  h.станДоПаузи in Очікує + ПеріодВиконано
  h.стан' = h.станДоПаузи
  no h.станДоПаузи'
  framesExceptStatus[h]
  framesExceptPause[h]
  all x: Звичка | x.поточнийПеріод' = x.поточнийПеріод
  ВиконаніЗаписи' = ВиконаніЗаписи
}

pred Архівувати[h: Звичка] {
  h.стан in Очікує + ПеріодВиконано
  h.стан' = Архівована
  framesExceptStatus[h]
  all x: Звичка | x.поточнийПеріод' = x.поточнийПеріод
  all x: Звичка | x.станДоПаузи' = x.станДоПаузи
  ВиконаніЗаписи' = ВиконаніЗаписи
}

pred ВідновитиЗАрхіву[h: Звичка, p: Період] {
  h.стан = Архівована
  p != h.поточнийПеріод
  h.стан' = Очікує
  h.поточнийПеріод' = p
  framesExceptStatus[h]
  framesExceptPeriod[h]
  all x: Звичка | x.станДоПаузи' = x.станДоПаузи
  ВиконаніЗаписи' = ВиконаніЗаписи
}

pred ПорожнійКрок {
  all h: Звичка | h.стан' = h.стан
  all h: Звичка | h.поточнийПеріод' = h.поточнийПеріод
  all h: Звичка | h.станДоПаузи' = h.станДоПаузи
  ВиконаніЗаписи' = ВиконаніЗаписи
}

pred Крок {
  ПорожнійКрок
  or (some h: Звичка | Активувати[h])
  or (some h: Звичка, r: ЗаписВиконання | ПозначитиВиконаною[h,r])
  or (some h: Звичка, p: Період | НовийПеріод[h,p])
  or (some h: Звичка | Призупинити[h] or Відновити[h] or Архівувати[h])
  or (some h: Звичка, p: Період | ВідновитиЗАрхіву[h,p])
}

pred КоректнаТраса { ПочатковийСтан and always Крок }

assert Безпека {
  КоректнаТраса implies always Інваріант
}
check Безпека for 2 but 5 steps expect 0

run ДосяжністьУсіхСтанів {
  КоректнаТраса and
  all s: HabitState | eventually some h: Звичка | h.стан = s
} for 2 but 10 steps expect 1

run ПовнийСценарій {
  КоректнаТраса and
  some h: Звичка, r: ЗаписВиконання |
    r.звичка = h and eventually (r in ВиконаніЗаписи)
} for 2 but 6 steps expect 1

assert ОчікуванняЗрештоюЗавершується {
  КоректнаТраса implies
    (all h: Звичка | always (h.стан = Очікує implies eventually h.стан = ПеріодВиконано))
}
check ОчікуванняЗрештоюЗавершується for 2 but 6 steps expect 1

-- Fairness: користувач надав запис для поточного періоду, і система не
-- пропускає нескінченно довго постійно доступну операцію фіксації.
pred ЄЗаписДляПеріоду[h: Звичка] {
  some r: ЗаписВиконання |
    r.звичка = h and r.період = h.поточнийПеріод and r not in ВиконаніЗаписи
}
pred ЗаписДоступний {
  always all h: Звичка | h.стан = Очікує implies ЄЗаписДляПеріоду[h]
}
pred СправедливеФіксування {
  all h: Звичка | always (
    (h.стан = Очікує and ЄЗаписДляПеріоду[h]) implies
      eventually (some r: ЗаписВиконання | ПозначитиВиконаною[h,r])
  )
}
pred ПрогресДоВиконання {
  all h: Звичка | always (h.стан = Очікує implies eventually h.стан = ПеріодВиконано)
}
assert ЖивучістьЗаСправедливості {
  (КоректнаТраса and ЗаписДоступний and СправедливеФіксування)
    implies ПрогресДоВиконання
}
check ЖивучістьЗаСправедливості for 2 but 8 steps expect 0

-- Мутаційний експеримент: у цій версії Призупинити закоментовано
-- передумову h.стан in Очікує + ПеріодВиконано.
pred ПризупинитиМутовано[h: Звичка] {
  h.стан != Призупинена
  h.стан' = Призупинена
  h.станДоПаузи' = h.стан
  framesExceptStatus[h]
  framesExceptPause[h]
  all x: Звичка | x.поточнийПеріод' = x.поточнийПеріод
  ВиконаніЗаписи' = ВиконаніЗаписи
}
assert МутованаПаузаЗберігаєІнваріант {
  all h: Звичка |
    (Інваріант and ПризупинитиМутовано[h]) implies
      ((h.стан' = Призупинена) iff some h.станДоПаузи') and
      (some h.станДоПаузи' implies h.станДоПаузи' in Очікує + ПеріодВиконано)
}
check МутованаПаузаЗберігаєІнваріант for 2 expect 1
