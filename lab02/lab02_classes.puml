@startuml
skinparam classAttributeIconSize 0

abstract class Користувач {
  # ідентифікатор: int
  # ім'я: String
  # електроннаПошта: String
  # пароль: String
  + оновитиПрофіль(): void
  + змінитиПароль(новийПароль: String): void
}

class ЗареєстрованийКористувач {
  - датаРеєстрації: Date
  - активний: boolean
  - часовийПояс: String
  + зареєструватися(): void
  + увійти(електроннаПошта: String, пароль: String): boolean
  + перевіритиДані(): boolean
  + створитиЗвичку(): Звичка
  + переглянутиСтатистику(): ЗвітАналітики
}

class Звичка {
  - ідентифікатор: int
  - назва: String
  - опис: String
  - періодичність: String
  - статус: String
  + створити(): void
  + оновити(): void
  + видалити(): void
  + отриматиПрогрес(): double
}

class Категорія {
  - ідентифікатор: int
  - назва: String
  - опис: String
  + додатиЗвичку(): void
  + видалитиЗвичку(): void
}

class ЗаписВиконання {
  - ідентифікатор: int
  - дата: Date
  - виконано: boolean
  - коментар: String
  + позначитиВиконаною(): void
  + скасуватиВиконання(): void
  + додатиКоментар(коментар: String): void
}

class Нагадування {
  - ідентифікатор: int
  - час: Time
  - активне: boolean
  - дніТижня: String
  + налаштувати(): void
  + надіслати(): void
}

class Ціль {
  - ідентифікатор: int
  - назва: String
  - цільовеЗначення: double
  - поточнеЗначення: double
  + оновитиПрогрес(): void
  + перевіритиДосягнення(): boolean
}

class ЗвітАналітики {
  - ідентифікатор: int
  - період: String
  - відсотокВиконання: double
  - датаСтворення: Date
  + сформуватиЗвіт(): void
  + розрахуватиСтатистику(): void
}

interface ВідстеженняПрогресу {
  + отриматиПрогрес(): double
  + оновитиПрогрес(): void
}

Користувач <|-- ЗареєстрованийКористувач

Звичка ..|> ВідстеженняПрогресу
Ціль ..|> ВідстеженняПрогресу

ЗареєстрованийКористувач "1" -- "0..*" Звичка
ЗареєстрованийКористувач "1" -- "0..*" Ціль
ЗареєстрованийКористувач "1" -- "0..*" ЗвітАналітики
ЗареєстрованийКористувач "1" -- "0..*" Нагадування

Категорія "1" o-- "0..*" Звичка

Звичка "1" *-- "0..*" ЗаписВиконання

Звичка "1" -- "0..*" Нагадування

Звичка "0..*" -- "0..*" Ціль

@enduml